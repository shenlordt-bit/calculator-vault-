<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTENTIONALLY NO PERMISSIONS ARE DECLARED HERE.
        No INTERNET, no ACCESS_NETWORK_STATE, no analytics SDK, no ad SDK.
        Do not add android.permission.INTERNET to this file for V1/V2/V3
        unless the product requirement itself changes.
    -->

    <application
        android:name=".VaultApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CalculatorVault"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- Visible entry point: looks like an ordinary calculator app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Vault screen: only reachable in-process after correct PIN. Not exported. -->
        <activity
            android:name=".vault.VaultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/vault_title" />

        <activity
            android:name=".ui.ChangePinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/change_pin_title" />

    </application>
</manifest>
