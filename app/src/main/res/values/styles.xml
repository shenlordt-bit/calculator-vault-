<resources>
    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/calc_btn_number</item>
        <item name="android:textColor">@color/calc_btn_text_light</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/calc_btn_function</item>
        <item name="android:textColor">@color/calc_btn_text_dark</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/calc_btn_operator</item>
        <item name="android:textColor">@color/calc_btn_text_light</item>
    </style>
</resources>
