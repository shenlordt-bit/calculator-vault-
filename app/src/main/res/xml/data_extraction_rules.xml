<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicitly exclude everything from cloud backup / device-to-device transfer.
  allowBackup="false" already disables this at the manifest level; this file
  is a defense-in-depth backstop in case allowBackup is ever re-enabled later.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
